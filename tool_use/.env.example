# Anthropic API 설정
# 이 파일을 .env로 복사하고 실제 값을 입력하세요

# https://console.anthropic.com/ 에서 발급한 Anthropic API key
ANTHROPIC_API_KEY=your_api_key_here

# 모델 이름 - memory_20250818 tool을 지원하는 모델 사용

# 지원 모델: claude-opus-4-1, claude-sonnet-4-6, claude-sonnet-4, claude-haiku-4-5

ANTHROPIC_MODEL=claude-sonnet-4-6