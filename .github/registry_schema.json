{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Registry Schema",
  "description": "registry.yaml용 Schema - cookbook metadata",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "description": "Cookbook 제목"
      },
      "description": {
        "type": "string",
        "description": "Cookbook의 간단한 설명"
      },
      "path": {
        "type": "string",
        "description": "Notebook 파일 경로"
      },
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$",
        "description": "Cookbook의 URL에 적합한 slug"
      },
      "categories": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "Agent Patterns",
            "Claude Agent SDK",
            "Claude Managed Agents",
            "Cybersecurity",
            "Evals",
            "Fine-Tuning",
            "Multimodal",
            "Integrations",
            "Observability",
            "RAG & Retrieval",
            "Responses",
            "Skills",
            "Thinking",
            "Tools"
          ]
        },
        "minItems": 1,
        "description": "Cookbook category"
      },
      "github_url": {
        "type": "string",
        "format": "uri",
        "description": "Notebook의 GitHub URL"
      },
      "authors": {
        "type": "array",
        "items": {
          "type": "string",
          "description": "GitHub username(authors.yml의 key와 일치해야 함)"
        },
        "minItems": 1,
        "description": "작성자 GitHub username 목록"
      },
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "YYYY-MM-DD 형식의 게시 날짜"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Cookbook tag"
      },
      "difficulty": {
        "type": "string",
        "enum": ["beginner", "intermediate", "advanced", ""],
        "description": "난이도(선택 사항)"
      },
      "use_case": {
        "type": "string",
        "description": "사용 사례 category(선택 사항)"
      },
      "thumbnail": {
        "type": "string",
        "description": "Thumbnail 이미지 URL(선택 사항)"
      },
      "archived": {
        "type": "boolean",
        "description": "Cookbook archive 여부(선택 사항, 기본값 false)"
      }
    },
    "required": ["title", "path", "categories", "authors", "date"],
    "additionalProperties": false
  }
}
