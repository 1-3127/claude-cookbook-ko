# Claude Skills Cookbook 설정
# 이 파일을 .env로 복사하고 실제 API key를 추가하세요

# 필수: https://console.anthropic.com/에서 받은 Anthropic API key
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model 선택(Skills에는 Claude 4.5 Sonnet 이상 필요)
ANTHROPIC_MODEL=claude-sonnet-4-6

# 선택 사항: Custom skills 저장 directory(기본값: ./custom_skills)
SKILLS_STORAGE_PATH=./custom_skills

# 선택 사항: 생성 파일의 output directory(기본값: ./outputs)
OUTPUT_PATH=./outputs
