# Webhook 등록 시 Anthropic이 발급(whsec_...)
ANTHROPIC_WEBHOOK_SECRET=

# Self-hosted environment id(env_01...)
ANTHROPIC_ENVIRONMENT_ID=

# Environment key — work poll/ack/stop과 runner의 session별 호출에 사용하는
# 단일 credential(sk-ant-oat...)
ANTHROPIC_ENVIRONMENT_KEY=

# 선택 사항. 기본값 https://api.anthropic.com.
# ANTHROPIC_BASE_URL=
