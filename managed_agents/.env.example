ANTHROPIC_API_KEY=sk-ant-...

# data_analyst_agent.ipynb output으로 채우며 slack_data_bot.ipynb에서 사용
ANALYST_ENV_ID=env_...
ANALYST_AGENT_ID=agent_...
ANALYST_AGENT_VERSION=...

# slack_data_bot.ipynb용
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# CMA_orchestrate_issue_to_pr.ipynb의 GitHub MCP 보조 예제,
# CMA_operate_in_production.ipynb의 vault 기반 MCP credentials,
# CMA_use_skills_from_a_repo.ipynb의 repository mount에 필요
GITHUB_TOKEN=ghp_...

# 선택 사항 — CMA_ tutorial에서 사용하는 기본 모델 재정의
COOKBOOK_MODEL=claude-sonnet-5

# 선택 사항 — CMA_consult_an_advisor.ipynb와
# CMA_coordinate_specialist_team.ipynb의 advisor 모델 재정의
COOKBOOK_ADVISOR_MODEL=claude-opus-5

# sre_incident_responder.ipynb용(production 연결에만 필요)
DD_API_KEY=
DD_APP_KEY=

# CMA_with_mongodb_atlas.ipynb용
# MONGO_URI만 반드시 필요합니다. Anthropic 인증은 위의 ANTHROPIC_API_KEY,
# ANTHROPIC_AUTH_TOKEN, ANTHROPIC_PROFILE(예: `ant` CLI의 workload-identity federation)에서 얻을 수 있습니다.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/   # Atlas SRV connection string(host 측에서만 사용)
# Embeddings + rerank provider(선택 사항 — seed에 미리 계산한 vector 제공). 하나 선택:
MDB_ATLAS_API_KEY=     # MongoDB Atlas AI endpoint(/v1/embeddings와 /v1/rerank 모두 제공)
VOYAGE_API_KEY=        # 또는 voyageai SDK 직접 사용(embeddings + rerank)
ENABLE_RERANK=         # 1로 설정하면 rerank 단계 활성화(위에서 설정한 key 사용)
AUTO_APPROVE=          # 1로 설정하면 비대화형 human gate 사용(CI / 무인 실행)
