# Claude API 설정
# 이 파일을 .env로 복사하고 API key 추가
# API key 발급: https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=sk-ant-api03-...

# 선택 사항: 테스트 기본 model(비용 절약을 위해 권장)
# 참고: claude-haiku-4-5는 2025년 10월 기준 최신 Haiku model
CLAUDE_MODEL=claude-haiku-4-5

# 선택 사항: 테스트 mode 설정
TEST_MODE=true
MAX_TOKENS=10

# 선택 사항: Debugging용 상세 출력
DEBUG=false
